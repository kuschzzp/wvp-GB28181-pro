server {
    listen 8080;
    server_name localhost;

    location / {
        root /opt/dist;
        index index.html index.htm;
    }

    # Media Hook callbacks travel directly over media-net to WVP. Never expose
    # their credential-bearing query string through the public reverse proxy.
    location ^~ /index/hook/ {
        access_log off;
        return 404;
    }

    # Download tickets are short lived but still credentials, so do not record
    # their path value in the public access log.
    location ~ ^/api/media/download/[A-Za-z0-9_-]+$ {
        access_log off;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_pass http://polaris-wvp:18978;
        proxy_read_timeout 2h;
    }

    location /api/ {
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header REMOTE-HOST $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_pass http://polaris-wvp:18978;
    }

    # The browser sends only a 30-second one-time ticket as a secondary
    # websocket subprotocol. WVP negotiates and echoes only wvp-log-v1.
    location = /channel/log {
        access_log off;
        proxy_pass http://polaris-wvp:18978;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Sec-WebSocket-Protocol $http_sec_websocket_protocol;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 1h;
    }

    # Only X-Accel-Redirect from WVP can enter this location. Direct external
    # requests are rejected by nginx because this location is internal.
    location ^~ /_protected_media/ {
        internal;
        alias /opt/media/bin/www/record/;
        sendfile on;
        add_header X-Content-Type-Options nosniff always;
    }

    # Playback protocols remain behind ZLM on_play ticket validation.
    location ^~ /rtp/ {
        proxy_pass http://polaris-media:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_connect_timeout 60s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 60s;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root html;
    }
}
